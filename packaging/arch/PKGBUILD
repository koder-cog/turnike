# Maintainer: koder-cog <https://github.com/koder-cog>
pkgname=turnike
pkgver=0.1.0
pkgrel=1
pkgdesc="GSB ve KYK yurt ağları için GTK4 ve Libadwaita masaüstü istemcisi ile CLI"
arch=('x86_64' 'aarch64')
url="https://github.com/koder-cog/turnike"
license=('AGPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'libsecret' 'openssl')
makedepends=('cargo')
optdepends=(
    'networkmanager: Ağ durumunu otomatik izleme ve oto-giriş desteği'
)
provides=('turnike' 'turnike-cli' 'turnike-daemon')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --workspace
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --workspace
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/turnike "$pkgdir/usr/bin/turnike"
    install -Dm755 target/release/turnike-cli "$pkgdir/usr/bin/turnike-cli"
    install -Dm755 target/release/turnike-daemon "$pkgdir/usr/bin/turnike-daemon"

    install -Dm644 data/io.github.koder_cog.Turnike.desktop "$pkgdir/usr/share/applications/io.github.koder_cog.Turnike.desktop"
    install -Dm644 data/io.github.koder_cog.Turnike.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.koder_cog.Turnike.metainfo.xml"
    install -Dm644 data/icons/hicolor/scalable/apps/io.github.koder_cog.Turnike.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.koder_cog.Turnike.svg"
    install -Dm644 data/icons/hicolor/symbolic/apps/io.github.koder_cog.Turnike-symbolic.svg "$pkgdir/usr/share/icons/hicolor/symbolic/apps/io.github.koder_cog.Turnike-symbolic.svg"
    install -Dm644 data/turnike-daemon.service "$pkgdir/usr/lib/systemd/user/turnike-daemon.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
